# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://egpp_user:egpp_pass@localhost:5432/egpp_db

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://:egpp_redis_pass@localhost:6379

# ─── JWT Authentication ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Firebase Cloud Messaging (FCM) ───────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@egpp.app

# ─── Cloudinary (Image CDN for Snap-to-Post) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OpenWeatherMap (Free tier for RUS weather factor) ────────────────────
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ─── ARCH-8 FIX: Nominatim (Free OpenStreetMap geocoding — no API key needed)
# For production scale: deploy self-hosted Nominatim via Docker
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=egpp-food-rescue/1.0 (admin@egpp.app)

# ─── Python AI Microservice ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# ARCH-2 FIX: 2000ms timeout before falling back to default rule-based pricing
AI_SERVICE_TIMEOUT_MS=2000

# ─── Hugging Face Vision AI ────────────────────────────────────────────────
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
HF_FOOD_MODEL=rajistics/finetuned-indian-food

# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Subscription Pricing (v1 revenue model) [PROD-5] ────────────────────
# v1: cash-at-pickup, revenue via vendor subscriptions
# PLATFORM_FEE_PERCENT is reserved for v2 Razorpay integration — inactive in v1
PLATFORM_FEE_PERCENT=10
SUBSCRIPTION_STARTER_PRICE=0
SUBSCRIPTION_RESCUE_PRICE=499
SUBSCRIPTION_CHAIN_PRICE=1999
